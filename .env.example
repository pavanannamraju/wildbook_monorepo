APP_NAME="Wildbook v1"
APP_ENV="local"
API_PREFIX="/api/v1"
BFF_API_PREFIX="/api"
LOG_LEVEL="INFO"
REQUEST_ID_HEADER="X-Request-ID"
HOST="127.0.0.1"
PORT=8000

# Single shared MongoDB database for the monolith
MONGO_URI=
MONGO_DATABASE_NAME="wildbook_v1"

# Optional maps dataset (separate DB/collection if you keep the parks dump)
MONGO_MAPS_DATA_DATABASE_NAME="wildlife_and_national_parks_database"
MONGO_MAPS_DATA_COLLECTION_NAME="wildlife_and_national_parks"

# Firebase auth (Google + email/password via frontend)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
AUTH_REQUIRED=true
AUTH_ADMIN_GOOGLE_EMAILS=

# Built SPA directory (relative to wildbook_v1/)
STATIC_DIR=static
