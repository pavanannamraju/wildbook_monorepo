# Dev-only Bun server (optional). Production SPA is served by FastAPI from ../static.
PORT=3001

# Leave empty for same-origin API calls when served by wildbook_v1.
# BUN_PUBLIC_BACKEND_ORIGIN=

BUN_PUBLIC_FIREBASE_API_KEY=
BUN_PUBLIC_FIREBASE_AUTH_DOMAIN=
BUN_PUBLIC_FIREBASE_PROJECT_ID=
BUN_PUBLIC_FIREBASE_APP_ID=

# Set to false/0/off to stop sending analytics from the browser (default: on).
# BUN_PUBLIC_ANALYTICS_ENABLED=true
